# Ignore environment variables
.env

# Ignore Python cache and compiled files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environment folders
venv/
env/
.venv/

# Ignore system and editor-specific files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Ignore logs and temporary files
*.log
*.tmp

# Ignore build and distribution folders
build/
dist/
*.egg-info/

# Ignore Jupyter notebook checkpoints (if any)
.ipynb_checkpoints/
