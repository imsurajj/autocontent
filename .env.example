# ==========================================
# APPWRITE CLOUD CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values from the Appwrite Console

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=autocontent-pro
APPWRITE_FUNCTION_ID=verify-license

# These are set ONLY inside Appwrite Function Environment Variables
# NEVER put these in your .env file committed to git!
