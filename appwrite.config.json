{
    "projectId": "6a09e8a5002e960936ec",
    "projectName": "Autocontent",
    "endpoint": "https://sgp.cloud.appwrite.io/v1",
    "settings": {
        "services": {
            "account": true,
            "avatars": true,
            "databases": true,
            "locale": true,
            "health": true,
            "storage": true,
            "teams": true,
            "users": true,
            "sites": true,
            "functions": true,
            "graphql": true,
            "messaging": true
        },
        "protocols": {
            "rest": true,
            "graphql": true,
            "websocket": true
        },
        "auth": {
            "methods": {
                "jwt": true,
                "phone": true,
                "invites": true,
                "anonymous": true,
                "email-otp": true,
                "magic-url": true,
                "email-password": true
            },
            "security": {
                "duration": 31536000,
                "limit": 0,
                "sessionsLimit": 0,
                "passwordHistory": 0,
                "passwordDictionary": false,
                "personalDataCheck": false,
                "sessionAlerts": false,
                "mockNumbers": []
            }
        }
    },
    "functions": [
        {
            "$id": "verify-license",
            "name": "verify-license",
            "runtime": "python-3.12",
            "path": "functions/verify-license",
            "entrypoint": "src/main.py",
            "execute": [
                "any"
            ],
            "enabled": true,
            "logging": true,
            "events": [],
            "schedule": "",
            "timeout": 15,
            "commands": "pip install -r requirements.txt",
            "scopes": [],
            "buildSpecification": "s-0.5vcpu-512mb",
            "runtimeSpecification": "s-0.5vcpu-512mb",
            "deploymentRetention": 0
        }
    ],
    "tablesDB": [
        {
            "$id": "autocontentdb",
            "name": "autocontent",
            "enabled": true
        }
    ],
    "tables": [
        {
            "$id": "licenses",
            "$permissions": [],
            "databaseId": "autocontentdb",
            "name": "licenses",
            "enabled": true,
            "rowSecurity": false,
            "columns": [
                {
                    "key": "userid",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 36,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "licenseKey",
                    "type": "string",
                    "required": true,
                    "array": false,
                    "size": 64,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "hardwareId",
                    "type": "string",
                    "required": false,
                    "array": false,
                    "size": 128,
                    "default": null,
                    "encrypt": false
                },
                {
                    "key": "expiresAt",
                    "type": "datetime",
                    "required": false,
                    "array": false,
                    "default": null,
                    "format": ""
                },
                {
                    "key": "isActive",
                    "type": "boolean",
                    "required": true,
                    "array": false,
                    "default": null
                }
            ],
            "indexes": []
        }
    ]
}